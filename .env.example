# Copie este arquivo para ".env" e preencha com sua chave real.
# O arquivo .env NUNCA deve ser commitado (já está no .gitignore).

# --- Google Gemini (free tier, sem cartão de crédito) ---
# Gere sua chave gratuita em: https://aistudio.google.com/apikey
GOOGLE_API_KEY=sua_chave_aqui

# --- Modelos ---
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/text-embedding-004

# --- Parâmetros de RAG (opcional, já tem valores padrão no config.py) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4

# --- OCI (preencher na etapa de deploy) ---
# OCI_COMPARTMENT_ID=
# OCI_GENAI_ENDPOINT=
